<div class="simple-page-action-wrapper fr-pt-5w">
  <div class="fr-grid-row fr-grid-row--center">
    <div class="fr-col-md-offset-1 fr-col-md-10">
      <turbo-frame id="main-modal-content">
        <div class="fr-modal__content">
          <h1 class="fr-modal__title">
            <%= t('.title', authorization_request_name: @authorization_request.name) %>
          </h1>

          <p>
            <%= t('.disclaimer').html_safe %>
          </p>

          <% if @authorization_request.next_stage_already_started? %>
            <div class="fr-alert fr-alert--warning">
              <%= t('.disclaimer_next_stage') %>
            </div>
          <% end %>
        </div>

        <div class="fr-modal__footer">
          <%= render partial: archive_modal_buttons_partial(@authorization_request), locals: { archive_path: namespace?(:instruction) ? instruction_authorization_request_archive_index_path(@authorization_request) : authorization_request_archive_index_path(@authorization_request) } %>
        </div>
      </turbo-frame>
    </div>
  </div>
</div>
