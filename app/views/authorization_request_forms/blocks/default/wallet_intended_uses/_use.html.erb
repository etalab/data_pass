<% open = wallet_intended_use_open?(@authorization_request, use) %>
<% body_id = wallet_intended_use_dom_id(index, 'body') %>
<% title_id = wallet_intended_use_dom_id(index, 'title') %>
<% focus = wallet_intended_use_focus(use) %>

<%= tag.div class: 'wx-panel usage-card', id: "usage-#{use.id}", data: { wallet_intended_uses_target: 'card', use_id: use.id, open: open } do %>
  <%= render Molecules::WalletRegistry::IntendedUseHeaderComponent.new(use:, title_id:, body_id:) %>

  <%= f.fields_for(:wallet_intended_uses, use, child_index: index, builder: DsfrFormBuilder) do |uf| %>
    <fieldset class="fr-fieldset fr-mb-0" aria-labelledby="<%= title_id %>" id="<%= body_id %>">
      <div class="fr-fieldset__element"><h4 class="fr-h6 fr-mb-1w"><%= wallet_intended_uses_t('sections.purpose') %></h4></div>
      <div class="fr-fieldset__element">
        <%= uf.dsfr_text_field :name, required: true, hint_text: wallet_intended_uses_t('fields.name.hint'), autofocus: focus == 'name', data: { action: 'input->wallet-intended-uses#nameChanged' } %>
      </div>
      <div class="fr-fieldset__element">
        <% purpose_length = use.purpose.to_s.length %>
        <% max_length = WalletRegistry::IntendedUse::PURPOSE_MAX_LENGTH %>
        <%= uf.dsfr_text_area :purpose, required: true, rows: 3,
          hint_text: safe_join([
            wallet_intended_uses_t('fields.purpose.hint'), ' ',
            tag.span(wallet_intended_uses_t('fields.purpose.counter', count: purpose_length, max: max_length), class: ['wx-count', ('is-over' if purpose_length > max_length)], aria: { live: 'polite' }, data: { wallet_intended_uses_target: 'purposeCounter' }),
          ]),
          data: { field_format_kind: 'purpose', action: 'input->wallet-intended-uses#purposeChanged', max_length: } %>
      </div>
      <div class="fr-fieldset__element">
        <%= uf.dsfr_url_field :privacy_policy_url, required: true, value: use.effective_privacy_policy_url, hint_text: wallet_intended_uses_t('fields.privacy_policy_url.hint'), data: { field_format_kind: 'https_url' } %>
      </div>

      <div class="fr-fieldset__element fr-mb-0"><hr class="fr-hr"></div>
      <%= render Organisms::WalletRegistry::IntendedUseDataComponent.new(use:, index:, focus_key: focus) %>

      <div class="fr-fieldset__element fr-mb-0"><hr class="fr-hr"></div>
      <div class="fr-fieldset__element"><h4 class="fr-h6 fr-mb-1w"><%= wallet_intended_uses_t('sections.period') %></h4></div>
      <div class="fr-fieldset__element">
        <div class="fr-grid-row fr-grid-row--gutters">
          <div class="fr-col-12 fr-col-md-6">
            <%= uf.dsfr_date_field :start_date, required: true, min: Date.current.iso8601, hint_text: wallet_intended_uses_t('fields.start_date.hint'), data: { field_format_kind: 'date_not_past' } %>
          </div>
          <div class="fr-col-12 fr-col-md-6">
            <%= uf.dsfr_date_field :end_date, required: false, hint_text: wallet_intended_uses_t('fields.end_date.hint'), data: { field_format_kind: 'date_after', field_format_after: uf.field_id(:start_date) } %>
          </div>
        </div>
      </div>
    </fieldset>
  <% end %>

  <%= render Organisms::WalletRegistry::CatalogModalComponent.new(authorization_request: @authorization_request, use:) %>
  <%= render Molecules::WalletRegistry::ConfirmationModalComponent.delete_use(authorization_request: @authorization_request, use:) %>
<% end %>
