<% set_title! t('page_titles.authorization_request_new', authorization_name: @authorization_request_form.authorization_definition.name) %>

<div class="fr-px-2w fr-px-md-0" id="wallet_registry_introduction">
  <h1 class="fr-h2 fr-mt-16v">
    <%= t('.title') %>
  </h1>

  <div class="border-frame-text fr-mb-6w">
    <p class="fr-mb-0">
      <%= t('.organization_html',
        organization_name: current_organization.name,
        organization_siret: current_organization.siret,
        form_name: @authorization_request_form.name) %>
    </p>
  </div>

  <section class="fr-mb-8w" id="wallet_registry_goals">
    <h2 class="fr-h5"><%= t('.goals_title') %></h2>
    <%= sanitize(@authorization_request_form.introduction) %>
  </section>

  <section class="fr-mb-8w" id="wallet_registry_preparation">
    <h2 class="fr-h5"><%= t('.preparation_title') %></h2>
    <ul>
      <% t('.preparation').each do |item| %>
        <li><%= item %></li>
      <% end %>
    </ul>
    <p id="wallet_registry_capacity"><%= t(".capacity.#{@wallet_registry_capacity}") %></p>
  </section>

  <section id="wallet_registry_form_steps">
    <h2 class="fr-h5"><%= t('.steps_title') %></h2>
    <p><%= t('authorization_request_forms.new.multiple_steps.description') %></p>
    <ol>
      <% t('.steps').each do |step| %>
        <li><%= step %></li>
      <% end %>
    </ol>
    <p><%= t('.verification_delay') %></p>
  </section>

  <div class="fr-grid-row fr-my-16v">
    <div class="fr-col">
      <%= link_to t('authorization_request_forms.new.back_to_dashboard'), dashboard_path, class: %w[fr-btn fr-btn--secondary fr-icon-home-4-line fr-btn--icon-left fr-mr-2w fr-mb-2w] %>
    </div>

    <%= link_to t('.start'),
      start_authorization_request_forms_path(form_uid: @authorization_request_form.id, params: new_authorization_request_hidden_params),
      class: %w[fr-btn fr-icon-save-line fr-btn--icon-left],
      id: dom_id(@authorization_request_form, :start_authorization_request) %>
  </div>
</div>
