<%= render layout: 'authorization_requests/shared/blocks/summary_block', locals: { authorization_request:, title: f.wording_for('steps.wallet_service'), block_id: :wallet_service, f:, editable: } do %>
  <% %i[wallet_service_name wallet_service_identifier wallet_service_description].each do |attribute| %>
    <p>
      <strong><%= authorization_request.class.human_attribute_name(attribute) %></strong>
      <br>
      <%= authorization_request.public_send(attribute).presence || t('authorization_requests.shared.not_filled') %>
    </p>
  <% end %>

  <p>
    <strong><%= f.wording_for('wallet_service.entitlement.label') %></strong>
    <br>
    <%= f.wording_for("wallet_service.entitlement.values.#{authorization_request.wallet_entitlement}") %>
  </p>
<% end %>
