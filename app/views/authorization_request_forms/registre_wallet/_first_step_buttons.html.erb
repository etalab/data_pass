<%# locals: (f:) -%>
<% content_for :sticky_bar do %>
  <div class="fr-container fr-grid-row">
    <div class="fr-col">
      <%= link_to t('authorization_request_forms.form.previous'), authorization_request_form_introduction_path(form_uid: @authorization_request.form_uid), id: :previous_authorization_request, class: %w(fr-btn fr-btn--secondary fr-icon-arrow-left-fill fr-btn--icon-left) %>
    </div>

    <%= f.button t('authorization_request_forms.form.next'), name: :next, type: :submit, id: :next_authorization_request, class: %w(fr-btn fr-btn--primary fr-btn--icon-right fr-icon-arrow-right-line) %>
  </div>
<% end %>
