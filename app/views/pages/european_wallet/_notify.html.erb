<div class="fr-follow" id="etre-prevenu">
  <div class="fr-container">
    <div class="fr-grid-row fr-grid-row--gutters">
      <div class="fr-col-12 fr-col-md-5">
        <h2 class="fr-h5"><%= t('.title') %></h2>
        <p class="fr-text--sm fr-mb-0"><%= t('.text') %></p>
      </div>
      <div class="fr-col-12 fr-col-md-7">
        <div class="lp-wallet-notify">
          <fieldset class="fr-fieldset lp-wallet-profile" aria-labelledby="etre-prevenu-profil-legende">
            <legend class="fr-fieldset__legend fr-fieldset__legend--regular" id="etre-prevenu-profil-legende"><%= t('.legend') %></legend>
            <% t('.profiles').each_with_index do |profile, index| %>
              <div class="fr-fieldset__element">
                <div class="fr-radio-group">
                  <input type="radio" id="etre-prevenu-profil-<%= index + 1 %>" name="etre-prevenu-profil">
                  <label class="fr-label" for="etre-prevenu-profil-<%= index + 1 %>"><%= profile %></label>
                </div>
              </div>
            <% end %>
          </fieldset>
          <div class="fr-input-group">
            <label class="fr-label" for="etre-prevenu-email">
              <%= t('.email_label') %>
              <span class="fr-hint-text"><%= t('.email_hint') %></span>
            </label>
            <div class="fr-input-wrap fr-input-wrap--addon">
              <input class="fr-input" type="email" id="etre-prevenu-email" autocomplete="email" aria-describedby="etre-prevenu-aide">
              <button type="button" class="fr-btn" title="<%= t('.submit_title') %>"><%= t('.submit') %></button>
            </div>
          </div>
          <p id="etre-prevenu-aide" class="fr-hint-text fr-mb-0"><%= t('.unsubscribe') %></p>
        </div>
      </div>
    </div>
  </div>
</div>
