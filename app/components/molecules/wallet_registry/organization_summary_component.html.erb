<div class="wx-sum-group">
  <h3 class="wx-sum-group__title"><%= t('.identification') %></h3>
  <div class="fr-container-fluid">
    <div class="fr-grid-row fr-grid-row--gutters">
      <%= render Molecules::WalletRegistry::SummaryFieldComponent.new(label: t('.legal_name'), value: legal_name) %>
      <%= render Molecules::WalletRegistry::SummaryFieldComponent.new(label: t('.siret'), value: formatted_siret) %>
      <%= render Molecules::WalletRegistry::SummaryFieldComponent.new(label: t('.country_code'), value: 'FR') %>
      <% if sirene_available? || authorization_request.identity_pending? %>
        <%= render Molecules::WalletRegistry::SummaryFieldComponent.new(label: t('.public_sector'), value: public_sector_label) %>
      <% end %>
      <% if address_withheld_from_public? %>
        <%= render Molecules::WalletRegistry::SummaryFieldComponent.new(label: t('.address'), width: :full) do %>
          <%= address %><br>
          <%= t('.address_not_published') %>
        <% end %>
      <% else %>
        <%= render Molecules::WalletRegistry::SummaryFieldComponent.new(label: t('.address'), value: address, width: :full) %>
      <% end %>
      <%= render Molecules::WalletRegistry::SummaryFieldComponent.new(label: t('.not_registered_elsewhere'), value: not_registered_elsewhere, width: :full) %>
    </div>
  </div>
</div>

<div class="wx-sum-group">
  <h3 class="wx-sum-group__title"><%= t('.for_users') %></h3>
  <div class="fr-container-fluid">
    <div class="fr-grid-row fr-grid-row--gutters">
      <%= render Molecules::WalletRegistry::SummaryFieldComponent.new(label: t('.privacy_policy'), value: value_or_not_filled(authorization_request.wallet_privacy_policy_url), width: :half) %>
      <%= render Molecules::WalletRegistry::SummaryFieldComponent.new(label: t('.website'), value: value_or_not_filled(authorization_request.wallet_website_url), width: :half) %>
      <%= render Molecules::WalletRegistry::SummaryFieldComponent.new(label: t('.support'), width: :half) do %>
        <%= support_channels.any? ? safe_join(support_channels, tag.br) : t('.not_filled') %>
      <% end %>
      <%= render Molecules::WalletRegistry::SummaryFieldComponent.new(label: t('.data_protection_authority'), width: :half) do %>
        <%= t('.data_protection_authority_name') %><br>
        <%= t('.data_protection_authority_contact') %>
      <% end %>
    </div>
  </div>
</div>
