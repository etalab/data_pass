<tr id="<%= dom_id(user) %>">
  <th scope="row">
    <% if user.family_name.present? && user.given_name.present? %>
      <p class="fr-mb-0"><%= user.full_name %></p>
    <% end %>
    <p class="fr-text--bold fr-mb-0"><%= user.email %></p>
  </th>
  <td>
    <ul role="list" class="fr-raw-list">
      <% user.organizations.each do |organization| %>
        <li>
          <% if organization.siret.present? %>
            <%= link_to "https://annuaire-entreprises.data.gouv.fr/etablissement/#{organization.siret}",
                  target: '_blank',
                  rel: 'noopener',
                  class: 'dp-user-rights-table__organisation-link',
                  title: organization_title(organization) do %>
              <span class="dp-user-rights-table__organisation-name"><%= organization.name %></span>
            <% end %>
          <% else %>
            <span class="dp-user-rights-table__organisation-name" title="<%= organization.name %>"><%= organization.name %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </td>
  <td>
    <% if no_rights? %>
      <p class="fr-mb-0" aria-hidden="true">&mdash;</p>
      <span class="fr-sr-only"><%= t('instruction.user_rights.index.table.no_role') %></span>
    <% else %>
      <ul role="list" class="fr-raw-list dp-user-rights-table__roles">
        <% role_types.each do |role_type| %>
          <li><%= render Atoms::ColorBadgeComponent.for_role(role_type, label: t("instruction.user_rights.roles.#{role_type}")) %></li>
        <% end %>
      </ul>
    <% end %>
  </td>
  <td class="fr-cell--multiline">
    <% if no_rights? %>
      <p class="fr-mb-0" aria-hidden="true">&mdash;</p>
      <span class="fr-sr-only"><%= t('instruction.user_rights.index.table.droits_count', count: 0) %></span>
    <% elsif all_access? %>
      <p class="fr-mb-0"><%= t('instruction.user_rights.index.table.all_access') %></p>
    <% else %>
      <% if fd_wildcard_provider_labels.any? %>
        <ul role="list" class="fr-raw-list">
          <% fd_wildcard_provider_labels.each do |label| %>
            <li><%= label %></li>
          <% end %>
        </ul>
      <% end %>
      <% if droits.any? %>
        <% if aggregate_droits? %>
          <details class="fr-mb-0">
            <summary class="dp-user-rights-table__droits-toggle">
              <%= t('instruction.user_rights.index.table.droits_count', count: droits.size) %>
              <span class="fr-icon-arrow-down-s-line fr-icon--sm dp-user-rights-table__droits-chevron" aria-hidden="true"></span>
            </summary>
            <ul role="list" class="fr-raw-list fr-mt-1w">
              <% droits.each do |definition| %>
                <li><%= definition.name_with_stage %></li>
              <% end %>
            </ul>
          </details>
        <% else %>
          <ul role="list" class="fr-raw-list">
            <% droits.each do |definition| %>
              <li><%= definition.name_with_stage %></li>
            <% end %>
          </ul>
        <% end %>
      <% end %>
    <% end %>
    <% if !all_access? && ambiguous_pairing? %>
      <button type="button" class="fr-btn--tooltip fr-btn" aria-describedby="<%= tooltip_id %>">
        <%= t('instruction.user_rights.index.table.pairing_tooltip_aria', email: user.email) %>
      </button>
      <span class="fr-tooltip fr-placement" id="<%= tooltip_id %>" role="tooltip" aria-hidden="true">
        <ul role="list" class="fr-raw-list">
          <% rights_by_definition.each do |entry| %>
            <li>
              <span class="fr-text--bold"><%= entry[:definition].name_with_stage %></span> :
              <%= entry[:role_types].map { |role_type| t("instruction.user_rights.roles.#{role_type}") }.join(', ') %>
            </li>
          <% end %>
        </ul>
      </span>
    <% end %>
  </td>
  <td class="fr-cell--multiline">
    <% if no_rights? %>
      <%= link_to t('instruction.user_rights.index.table.add_cta'),
            helpers.new_user_right_path(email: user.email),
            class: 'fr-btn fr-btn--secondary fr-btn--sm',
            aria: { label: t('instruction.user_rights.index.table.add_aria', email: user.email) } %>
    <% elsif editable? %>
      <%= link_to t('instruction.user_rights.index.table.manage_cta'),
            helpers.edit_user_right_path(user),
            class: 'fr-btn fr-btn--secondary fr-btn--sm',
            aria: { label: t('instruction.user_rights.index.table.edit_aria', email: user.email) } %>
    <% end %>
  </td>
</tr>
