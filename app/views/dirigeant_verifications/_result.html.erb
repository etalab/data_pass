<% if result['status'] == 'success' %>
  <div class="fr-alert fr-alert--success fr-mb-4w" role="status">
    <h2 class="fr-alert__title"><%= t('.success.title') %></h2>
    <dl>
      <% DirigeantVerificationsController::DISPLAYED_VERIFICATION_ATTRIBUTES.each do |attribute| %>
        <dt><%= t(".attributes.#{attribute}") %></dt>
        <dd><%= Array(result.dig('details', attribute)).join(', ').presence || t('.empty') %></dd>
      <% end %>
    </dl>
  </div>
<% else %>
  <div class="fr-alert fr-alert--error fr-mb-4w" role="alert">
    <h2 class="fr-alert__title"><%= t('.failure.title') %></h2>
    <p><%= t(".failure.reasons.#{result['reason']}", default: t('.failure.reasons.generic')) %></p>
    <p><%= t('.failure.support') %></p>
  </div>
<% end %>
