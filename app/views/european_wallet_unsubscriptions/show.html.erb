<% set_title! t('page_titles.european_wallet_unsubscription_show') %>

<h1 class="fr-h2 fr-my-5w"><%= t('.title') %></h1>

<p><%= t('.description') %></p>

<%= form_with url: european_wallet_unsubscription_path, method: :post, data: { turbo: false } do |f| %>
  <%= f.hidden_field :token, value: params[:token] %>
  <%= f.button t('.cta'), type: 'submit', class: 'fr-btn' %>
<% end %>

<p class="fr-mt-4w">
  <%= link_to t('.back'), european_wallet_page_path, class: 'fr-link' %>
</p>
