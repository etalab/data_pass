<%# locals: (authorization_request:) -%>
<% incomplete_steps = authorization_request.wallet_incomplete_steps %>

<% if incomplete_steps.any? %>
  <div class="fr-alert fr-alert--error fr-mb-6w" id="wallet-incomplete-steps" tabindex="-1" autofocus data-controller="scroll-into-view">
    <h3 class="fr-alert__title"><%= t('authorization_request_forms.registre_wallet.summary.incomplete_steps.title') %></h3>
    <p><%= t('authorization_request_forms.registre_wallet.summary.incomplete_steps.description') %></p>
    <ul>
      <% incomplete_steps.each do |step| %>
        <li>
          <%= link_to t('authorization_request_forms.registre_wallet.summary.incomplete_steps.link', position: authorization_request.steps_names.index(step) + 1, name: t("authorization_request_forms.registre_wallet.summary.incomplete_steps.steps.#{step}")),
            edit_authorization_request_block_path(authorization_request, t("wicked.#{step}")),
            class: 'fr-link' %>
          <% if step == 'wallet_organization' %>
            <% %i[identity_source identity_public_sector].flat_map { |attribute| authorization_request.errors.messages_for(attribute) }.each do |message| %>
              <p class="fr-mb-0"><%= message %></p>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
