<div class="fr-mt-5w fr-mb-3w">
  <div class="homepage-subtitle">
    <h2 class="fr-h6">
      <%= t('pages.home.pro_connect_connexion') %>
    </h2>
  </div>
  <%= form_with(url: "/auth/#{local_assigns.fetch(:identity_federator, 'proconnect')}", method: :post, data: { turbo: false }) do |f| %>
    <%= f.button class: %w(fr-connect fr-connect--pro fr-m-auto), id: 'login_pro_connect' do %>
      <span class="fr-connect__login">
        <%= t('pages.home.pro_connect_login') %>
      </span>
      <span class="fr-connect__brand">
        <%= t('pages.home.pro_connect_brand') %>
      </span>
    <% end %>

    <p>
      <a href="https://www.proconnect.gouv.fr/" target="_blank" rel="noopener" title="<%= t('pages.home.pro_connect_subtitle') %> - <%= t('shared.new_window') %>">
        <%= t('pages.home.pro_connect_subtitle') %>
        <span class="fr-sr-only"> - <%= t('shared.new_window') %></span>
      </a>
    </p>
  <% end %>

  <%= render partial: 'pages/shared/unauthenticated_pages/bypass_login_info' if local_sign_in_panel_visible? %>
</div>
