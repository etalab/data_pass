<%= f.info_for(:legal) %>

<div class="legal-border-card">
  <p class="fr-h5 legal-subtitle">
    <%= f.wording_for('legal.nature.title') %>
  </p>

  <div class="fr-fieldset__element">
    <%=
      f.dsfr_select :nature_juridique,
        options_for_select(
          AuthorizationRequest::Resana::NATURES_JURIDIQUES.map { |value| [f.wording_for("nature_juridique.values.#{value}"), value] },
          selected: @authorization_request.nature_juridique
        ),
        required: true,
        include_blank: f.wording_for('nature_juridique.prompt')
    %>
  </div>
</div>

<fieldset class="fr-fieldset legal-border-card fr-mt-3w" aria-describedby="resana-habilitation-hint">
  <legend class="fr-fieldset__legend fr-h5 legal-subtitle">
    <%= f.wording_for('legal.habilitation.title') %>
    <span class="fr-hint-text" id="resana-habilitation-hint"><%= f.wording_for('legal.habilitation.hint') %></span>
  </legend>

  <div class="fr-fieldset__element">
    <%= f.dsfr_check_box :habilitation_certifiee, required: false %>
  </div>

  <div class="legal-bloc-separation fr-fieldset__element">
    <div class="legal-line"></div>
    <div class="legal-centered__element">
      <p class="fr-h5"><%= f.wording_for('legal.habilitation.separator') %></p>
    </div>
    <div class="legal-line"></div>
  </div>

  <div class="fr-fieldset__element">
    <%= f.dsfr_file_field :lettre_habilitation_document, multiple: true, required: false %>
  </div>
</fieldset>
