<div class="fr-header__menu fr-modal" id="modal-header-menu" aria-labelledby="fr-btn-menu-mobile-1">
  <div class="fr-container">
    <button class="fr-link--close fr-link" aria-controls="modal-header-menu" aria-label="Fermer le menu">
      Fermer
    </button>

    <div class="fr-header__menu-links"></div>
    <nav class="fr-nav" id="navigation-header-menu" aria-label="Menu principal">
      <ul class="fr-nav__list">
        <% if namespace?(:instruction) %>
          <%= render Atoms::InstructorMenuComponent.new(
            show_drafts: policy([:instruction, :instructor_draft_request]).enabled?,
            show_templates: policy([:instruction, :message_template]).index?,
            show_user_rights: policy([:instruction, :user_right]).index?,
            show_definitions: authorization_definitions_feature_enabled? && policy([:instruction, :authorization_definition]).index?
          ) %>
        <% end %>
        <% if public_header? %>
          <li class="fr-nav__item">
            <%= link_to t('.public.home'), root_path, class: 'fr-nav__link', aria: { current: current_page?(root_path) ? 'page' : nil } %>
          </li>
          <li class="fr-nav__item">
            <%= link_to t('.public.european_wallet'), european_wallet_page_path, class: 'fr-nav__link', aria: { current: current_page?(european_wallet_page_path) ? 'page' : nil } %>
          </li>
        <% end %>
      </ul>
    </nav>
  </div>
</div>
