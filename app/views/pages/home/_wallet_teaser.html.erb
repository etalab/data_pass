<%= render Organisms::HeroComponent.new(
  kicker: t('.kicker'),
  title: t('.title'),
  heading: { class: 'fr-h3', id: 'teaser-titre' },
  section: { id: 'portefeuille-europeen', class: 'lp-teaser' }
) do |hero| %>
  <% hero.with_lead do %>
    <p><%= t('.text') %></p>
  <% end %>
  <% hero.with_actions do %>
    <%= link_to t('.button'), european_wallet_page_path, class: 'fr-btn fr-icon-arrow-right-line fr-btn--icon-right' %>
  <% end %>
  <% hero.with_illustration do %>
    <%= render european_wallet_phone_mockup(caption_id: 'phone-legende') %>
  <% end %>
<% end %>
