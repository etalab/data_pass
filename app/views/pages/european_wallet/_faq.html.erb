<section class="fr-py-8w" id="questions" aria-labelledby="questions-titre">
  <div class="fr-container">
    <h2 id="questions-titre"><%= t('.title') %></h2>
    <% %w[organizations partners individuals].each do |group| %>
      <div class="lp-wallet-faq-group">
        <h3><%= t(".#{group}_title") %></h3>
        <div class="lp-faq">
          <%= render partial: 'shared/faq_group', locals: { questions: t(".#{group}") } %>
        </div>
      </div>
    <% end %>
  </div>
</section>
