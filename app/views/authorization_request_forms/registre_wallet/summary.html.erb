<% set_title! t('page_titles.authorization_request_summary', definition_name: @authorization_request.definition.name) %>
<% provide :wallet_registry_summary, 'true' %>

<%= authorization_request_form(@authorization_request, form_options: { html: { novalidate: true } }) do |f| %>
  <div id="<%= dom_id(@authorization_request, :summary) %>">
    <% if @authorization_request.draft? %>
      <div class="fr-mb-6w">
        <h2 class="fr-h3 fr-mb-1w"><%= f.wording_for('summary.title') %></h2>
        <p class="fr-mb-0 wx-lede"><%= f.wording_for('summary.subtitle') %></p>
      </div>
    <% end %>

    <% @authorization_request.blocks.each do |block| %>
      <%= render_custom_block_or_default(@authorization_request, block[:name], f:, editable: @authorization_request.editable_by_applicant? && block[:editable]) %>
    <% end %>

    <% if @authorization_request.draft? %>
      <%= render partial: 'authorization_request_forms/registre_wallet/consents', locals: { f:, authorization_request: @authorization_request } %>
      <%= render partial: 'authorization_request_forms/registre_wallet/incomplete_steps', locals: { authorization_request: @authorization_request } %>
    <% else %>
      <%= render_accepted_tos_checkboxes(@authorization_request, f:, editable: false) %>
    <% end %>
  </div>

  <% if policy(@authorization_request).submit? %>
    <% content_for :sticky_bar do %>
      <div class="fr-container fr-grid-row">
        <div class="fr-col-12">
          <ul class="fr-btns-group fr-btns-group--inline fr-btns-group--icon-left fr-btns-group--right">
            <li>
              <%= f.button f.wording_for('summary.submit'), type: :submit, name: :submit, id: :submit_authorization_request, class: %w(fr-btn fr-icon-checkbox-line fr-btn--icon-left fr-mb-0), data: { turbo_submits_with: f.wording_for('summary.submitting') } %>
            </li>
          </ul>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
