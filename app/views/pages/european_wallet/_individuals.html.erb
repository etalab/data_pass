<p class="lp-kicker"><%= t('.kicker') %></p>
<h3 class="fr-h4"><%= t('.title') %></h3>
<ul class="lp-wallet-rights">
  <li>
    <%= render Atoms::PictogramComponent.new(name:'document/document-search') %>
    <div class="lp-wallet-rights__body">
      <h4><%= t('.rights.registered.title') %></h4>
      <p><%= t('.rights.registered.text') %></p>
      <p class="lp-wallet-rights__link">
        <%= link_to t('.rights.registered.link'), european_wallet_public_registry_path, class: 'fr-link fr-icon-arrow-right-line fr-link--icon-right' %>
      </p>
    </div>
  </li>
  <li>
    <%= render Atoms::PictogramComponent.new(name:'digital/application') %>
    <div class="lp-wallet-rights__body">
      <h4><%= t('.rights.choice.title') %></h4>
      <p><%= t('.rights.choice.text') %></p>
      <p class="lp-wallet-rights__link">
        <%= link_to 'https://france-identite.gouv.fr/', class: 'fr-link', target: '_blank', rel: 'noopener', title: t('.rights.choice.link_title') do %>
          <%= t('.rights.choice.link') %><span class="fr-sr-only"> - <%= t('shared.new_window') %></span>
        <% end %>
      </p>
    </div>
  </li>
  <li>
    <%= render Atoms::PictogramComponent.new(name:'system/warning') %>
    <div class="lp-wallet-rights__body">
      <h4><%= t('.rights.report.title') %></h4>
      <p><%= t('.rights.report.text') %></p>
      <p class="lp-wallet-rights__link">
        <%= link_to 'https://www.cnil.fr/fr/adresser-une-plainte', class: 'fr-link', target: '_blank', rel: 'noopener', title: t('.rights.report.link_title') do %>
          <%= t('.rights.report.link') %><span class="fr-sr-only"> - <%= t('shared.new_window') %></span>
        <% end %>
      </p>
    </div>
  </li>
</ul>
<div class="lp-wallet-who">
  <h4 class="lp-wallet-who__title"><%= t('.who.title') %></h4>
  <dl class="lp-wallet-who__list">
    <% t('.who.items').each do |item| %>
      <div>
        <dt><%= item[:term] %></dt>
        <dd><%= item[:description] %></dd>
      </div>
    <% end %>
  </dl>
</div>
<p class="fr-mt-3w fr-mb-0">
  <%= link_to 'https://www.numerique.gouv.fr/actualites/portefeuille-europeen-identite-numerique-eu-digital-identity-wallets/', class: 'fr-link', target: '_blank', rel: 'noopener', title: t('.dinum_link_title') do %>
    <%= t('.dinum_link') %><span class="fr-sr-only"> - <%= t('shared.new_window') %></span>
  <% end %>
</p>
