<%# locals: (f:) -%>
<% if !@summary_before_submit && policy(@authorization_request).update? %>
  <%= f.button t('authorization_request_forms.form.save_header'), name: :save, type: :submit, id: :save_authorization_request_from_header, class: %w(fr-btn fr-btn--sm fr-btn--secondary fr-icon-save-line fr-btn--icon-left) %>
<% end %>
<% if policy(@authorization_request).archive? %>
  <%= dsfr_main_modal_button t('authorization_request_forms.form.archive'), new_authorization_request_archive_path(@authorization_request), id: :archive_authorization_request, class: %w(fr-btn fr-btn--sm fr-btn--tertiary fr-btn--icon-left fr-icon-delete-line) %>
<% end %>
