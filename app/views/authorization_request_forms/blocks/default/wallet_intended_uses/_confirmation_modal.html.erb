<dialog aria-labelledby="<%= modal_id %>-title" id="<%= modal_id %>" class="fr-modal" role="alertdialog">
  <div class="fr-container fr-container--fluid fr-container-md">
    <div class="fr-grid-row fr-grid-row--center">
      <div class="fr-col-12 fr-col-md-8 fr-col-lg-6">
        <div class="fr-modal__body">
          <div class="fr-modal__header">
            <button type="button" class="fr-btn--close fr-btn" aria-controls="<%= modal_id %>"><%= wording.fetch(:close) %></button>
          </div>
          <div class="fr-modal__content">
            <h1 id="<%= modal_id %>-title" class="fr-modal__title"><%= wording.fetch(:title) %></h1>
            <p><%= wording.fetch(:detail) %></p>
            <p class="fr-mb-0"><%= wording.fetch(:warning) %></p>
          </div>
          <div class="fr-modal__footer">
            <ul class="fr-btns-group fr-btns-group--right fr-btns-group--inline-reverse fr-btns-group--inline-lg">
              <li><%= wallet_intended_use_command_button(@authorization_request, command, wording.fetch(:confirm), class: 'fr-btn') %></li>
              <li><button type="button" class="fr-btn fr-btn--secondary" aria-controls="<%= modal_id %>"><%= wording.fetch(:cancel) %></button></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</dialog>
